    "styles": {
        "color": {
            "background": "var:preset|color|background-color",
            "text": "var:preset|color|text-color"
        },
        "typography": {
            "fontFamily": "var:preset|font-family|heebo",
            "fontSize": "var:preset|font-size|normal",
            "lineHeight": "1.6"
        },
        "blocks": {
            "core/post-title": {
                "typography": {
                    "fontFamily": "var:preset|font-family|heebo",
                    "fontSize": "var:preset|font-size|x-large",
                    "lineHeight": "1.2"
                }
            },
            "core/heading": {
                "typography": {
                    "fontFamily": "var:preset|font-family|heebo"
                },
                "elements": {
                    "h1": {
                        "typography": {
                            "fontSize": "var:preset|font-size|x-large"
                        }
                    },
                    "h2": {
                        "typography": {
                            "fontSize": "var:preset|font-size|large"
                        }
                    },
                    "h3": {
                        "typography": {
                            "fontSize": "var:preset|font-size|medium"
                        }
                    },
                    "h4": {
                        "typography": {
                            "fontSize": "var:preset|font-size|normal"
                        }
                    },
                    "h5": {
                        "typography": {
                            "fontSize": "var:preset|font-size|small"
                        }
                    },
                    "h6": {
                        "typography": {
                            "fontSize": "var:preset|font-size|small"
                        }
                    }
                }
            },
            "core/paragraph": {
                "typography": {
                    "fontFamily": "var:preset|font-family|heebo",
                    "fontSize": "var:preset|font-size|normal"
                }
            },
            "core/button": {
                "color": {
                    "background": "var:preset|color|primary-color",
                    "text": "var:preset|color|light-text-color"
                },
                "border": {
                    "radius": "5px"
                },
                "spacing": {
                    "padding": {
                        "top": "1rem",
                        "right": "1.5rem",
                        "bottom": "1rem",
                        "left": "1.5rem"
                    }
                }
            },
            "core/group": {
                "spacing": {
                    "blockGap": "1.5rem"
                }
            },
            "core/table": {
                "elements": {
                    "thead": {
                        "color": {
                            "background": "var:preset|color|text-color",
                            "text": "var:preset|color|primary-color"
                        },
                        "typography": {
                            "fontWeight": "700"
                        }
                    }
                }
            }
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var:preset|color|primary-color"
                },
                ":hover": {
                    "color": {
                        "text": "var:preset|color|secondary-color"
                    }
                }
            }
        }
    }
}